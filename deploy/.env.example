# Infrastructure
POSTGRES_DB=aegis_telemetry
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=change_this_password

# Multi-Model AI Routing (Zero Cost by default -- leave NVIDIA_NIM_API_KEY blank
# to route straight to local Ollama)
NVIDIA_NIM_API_KEY=
PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b
FALLBACK_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DEFAULT_LOCALE=te
